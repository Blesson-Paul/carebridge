<nav class="landing-navbar">
  <%= link_to root_path, class: "brand" do %>
    <span class="brand-icon">♡</span>
    <span>Care<span>Bridge</span></span>
  <% end %>

  <div class="nav-actions">
     <% if user_signed_in? %>
      <%= link_to "My Conditions", conditions_path, class: "btn btn-outline" %>
      <%= link_to edit_user_registration_path, class: "user-pill text-decoration-none", title: "Edit Profile" do %>
        <span class="user-avatar-circle">
          <i class="fa-regular fa-user"></i>
        </span>
        <span class="user-name"><%= current_user.name.presence || current_user.email.split('@').first.capitalize %></span>
      <% end %>
      <%= button_to "Log Out", destroy_user_session_path, method: :delete, class: "btn btn-outline btn-logout" %>
    <% else %>
      <%= link_to "Log In", new_user_session_path, class: "btn btn-outline" %>
      <%= link_to "Get Started", new_user_registration_path, class: "btn btn-primary" %>
    <% end %>
  </div>
</nav>
