<div class="auth-page">
  <%= link_to root_path, class: "auth-brand" do %>
    <span class="brand-icon">♡</span>
    <span>Care<span>Bridge</span></span>
  <% end %>

  <main class="auth-shell">
    <section class="auth-card">
      <p class="eyebrow">START YOUR CARE SPACE</p>

      <h1>Create your account</h1>
      <p class="auth-subtitle">
        Set up one simple place to track a patient’s conditions, symptoms, and AI health reports.
      </p>

      <form class="auth-form" action="#" method="post">
        <div class="form-group">
          <label for="fullname">Full name</label>
          <input id="fullname" name="fullname" type="text" placeholder="Your full name">
        </div>

        <div class="form-grid">
          <div class="form-group">
            <label for="date_of_birth">Date of birth</label>
            <input id="date_of_birth" name="date_of_birth" type="date">
            <small id="age_preview">Choose date of birth to see age.</small>
          </div>

          <div class="form-group">
            <label for="gender">Gender</label>
            <select id="gender" name="gender">
              <option value="">Select gender</option>
              <option value="female">Female</option>
              <option value="male">Male</option>
              <option value="other">Other</option>
              <option value="prefer_not_to_say">Prefer not to say</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label for="email">Email address</label>
          <input id="email" name="email" type="email" placeholder="you@example.com">
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <input id="password" name="password" type="password" placeholder="Create a password">
        </div>

        <div class="form-group">
          <label for="password_confirmation">Confirm password</label>
          <input id="password_confirmation" name="password_confirmation" type="password" placeholder="Repeat your password">
        </div>

        <button class="btn btn-primary auth-submit" type="submit">Create Account</button>
      </form>

      <p class="auth-footer">
        Already have an account?
        <%= link_to "Log in", login_path %>
      </p>
    </section>

    <section class="auth-preview">
      <div class="auth-glow"></div>

      <div class="preview-panel">
        <div class="preview-icon">✦</div>
        <h2>Begin with one patient profile.</h2>
        <p>
          Keep the MVP small: one user, one patient, clear health notes, and simple AI support.
        </p>

        <div class="preview-list">
          <div>
            <span>✓</span>
            Save name, DOB, and gender
          </div>
          <div>
            <span>✓</span>
            Show age from date of birth
          </div>
          <div>
            <span>✓</span>
            Start tracking daily care
          </div>
        </div>
      </div>
    </section>
  </main>
</div>
