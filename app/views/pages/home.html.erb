<div class="landing-page">
  <nav class="landing-navbar">
    <div class="brand">
      <span class="brand-icon">♡</span>
      <span>Care<span>Bridge</span></span>
    </div>

    <div class="nav-actions">
      <%= link_to "Log In", login_path, class: "btn btn-outline" %>
      <%= link_to "Get Started", signup_path, class: "btn btn-primary" %>
    </div>
  </nav>

  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">✦ AI HEALTH COMPANION</p>

      <h1>
        Better care.<br>
        Stronger <span>you.</span>
      </h1>

      <p class="hero-description">
        Care Bridge helps you track your conditions, understand your health better
        and get AI-powered support whenever you need it.
      </p>

      <div class="hero-actions">
        <%= link_to signup_path, class: "btn btn-primary btn-large" do %>
          Get Started <span>›</span>
        <% end %>
        <%= link_to "Log In", login_path, class: "btn btn-outline btn-large" %>
      </div>

      <div class="hero-features">
        <div class="mini-feature">
          <div class="mini-icon">♡</div>
          <h3>Track Conditions</h3>
          <p>Add and manage your health conditions.</p>
        </div>

        <div class="mini-feature">
          <div class="mini-icon">💬</div>
          <h3>AI Chat</h3>
          <p>Chat with AI based on your condition.</p>
        </div>

        <div class="mini-feature">
          <div class="mini-icon">▥</div>
          <h3>Daily Overview</h3>
          <p>See your health summary daily.</p>
        </div>

        <div class="mini-feature">
          <div class="mini-icon">♢</div>
          <h3>Private & Secure</h3>
          <p>Your data is safe with us.</p>
        </div>
      </div>
    </div>

    <div class="hero-visual">
      <div class="glow-circle"></div>

      <div class="phone-card">
        <div class="phone-top">
          <span>9:41</span>
          <span>● ● ●</span>
        </div>

        <div class="phone-greeting">
          <h2>Good morning, Alex</h2>
          <p>Here's your health overview</p>
        </div>

        <div class="summary-card">
          <div class="summary-header">
            <strong>Today's Summary</strong>
            <span>May 18, 2024</span>
          </div>

          <div class="phone-stats">
            <div>
              <strong>2</strong>
              <span>Conditions</span>
            </div>

            <div>
              <strong>3</strong>
              <span>Symptoms</span>
            </div>

            <div>
              <strong>1</strong>
              <span>Chats</span>
            </div>
          </div>
        </div>

        <div class="activity-card">
          <div class="activity-header">
            <strong>Recent Activity</strong>
            <a href="#">View all</a>
          </div>

          <div class="activity-row">
            <span class="activity-icon purple">💬</span>
            <div>
              <strong>Chat with AI</strong>
              <p>Headache discussion</p>
            </div>
            <time>10:30 AM</time>
          </div>

          <div class="activity-row">
            <span class="activity-icon pink">♡</span>
            <div>
              <strong>Condition Updated</strong>
              <p>Hypertension</p>
            </div>
            <time>Yesterday</time>
          </div>

          <div class="activity-row">
            <span class="activity-icon green">▤</span>
            <div>
              <strong>Daily Report</strong>
              <p>Symptoms and mood logged</p>
            </div>
            <time>May 17</time>
          </div>
        </div>

        <div class="phone-tabs">
          <span>Dashboard</span>
          <span>Conditions</span>
          <span>AI Chat</span>
          <span>Profile</span>
        </div>
      </div>

      <div class="floating-heart">♡</div>
      <div class="security-badge">🔒</div>
    </div>
  </section>

  <section class="bottom-note">
    <div class="quote-mark">“</div>
    <div>
      <strong>Your health journey is important.</strong>
      <p>We're here to bridge the gap between you and better care.</p>
    </div>

    <div class="note-divider"></div>

    <div class="note-brand">
      <div class="brand-icon">♡</div>
      <div>
        <strong>Care Bridge</strong>
        <p>Your bridge to smarter, healthier living.</p>
      </div>
    </div>
  </section>
</div>
