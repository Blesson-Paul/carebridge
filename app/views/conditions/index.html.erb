<div class="conditions-page">
  <!-- Patient Profile Summary Card -->
  <div class="patient-profile-card">
    <div class="profile-main-row">
      <div class="profile-user-info">
        <div class="profile-avatar">
          <i class="fa-regular fa-user"></i>
        </div>
        <div>
          <span class="patient-badge">PATIENT PROFILE</span>
          <h1><%= current_user.name.presence || "Patient" %></h1>
          <p class="profile-email"><%= current_user.email %></p>
        </div>
      </div>

      <div class="profile-actions d-flex gap-2">
        <%= link_to edit_user_registration_path, class: "btn btn-outline" do %>
          <i class="fa-solid fa-user-pen me-1"></i> Edit profile
        <% end %>
        <%= link_to new_condition_path, class: "btn btn-primary" do %>
          <i class="fa-solid fa-plus me-1"></i> Add condition
        <% end %>
      </div>
    </div>

    <div class="profile-meta-grid">
      <div class="profile-pill">
        <span class="pill-label">AGE</span>
        <strong class="pill-value">
          <%= calculate_age(current_user.date_of_birth) %>
          <% if current_user.date_of_birth %>
            <small class="pill-sub">(<%= current_user.date_of_birth.strftime("%b %Y") %>)</small>
          <% end %>
        </strong>
      </div>

      <div class="profile-pill">
        <span class="pill-label">GENDER</span>
        <strong class="pill-value"><%= current_user.gender.presence || "Not specified" %></strong>
      </div>

      <div class="profile-pill">
        <span class="pill-label">ACTIVE CONDITIONS</span>
        <strong class="pill-value"><%= @active_conditions.count %></strong>
      </div>

      <div class="profile-pill">
        <span class="pill-label">ARCHIVED HISTORY</span>
        <strong class="pill-value"><%= @archived_conditions.count %></strong>
      </div>
    </div>
  </div>

  <!-- Dashboard Filter Tabs -->
  <div class="dashboard-tabs-row">
    <div class="dashboard-tabs">
      <%= link_to conditions_path(tab: :active), class: "tab-btn #{@tab == 'active' ? 'active' : ''}" do %>
        <i class="fa-solid fa-heart-pulse me-1"></i> Active Conditions
        <span class="tab-badge"><%= @active_conditions.count %></span>
      <% end %>

      <%= link_to conditions_path(tab: :archived), class: "tab-btn #{@tab == 'archived' ? 'active' : ''}" do %>
        <i class="fa-solid fa-box-archive me-1"></i> Archived History
        <span class="tab-badge"><%= @archived_conditions.count %></span>
      <% end %>
    </div>
  </div>

  <% if @conditions.any? %>
    <div class="conditions-grid">
      <% @conditions.each do |condition| %>
        <div class="condition-card <%= condition.archived? ? 'condition-card-archived' : '' %>">
          <div class="condition-card-header">
            <div class="condition-icon <%= condition.archived? ? 'icon-archived' : '' %>">
              <%= condition.archived? ? "📁" : "♡" %>
            </div>
            <div class="d-flex gap-2 align-items-center">
              <% if condition.archived? %>
                <span class="condition-status status-archived">Archived</span>
              <% else %>
                <span class="condition-status <%= condition.cured? ? 'status-cured' : 'status-active' %>">
                  <%= condition.cured? ? "Cured" : "Active" %>
                </span>
              <% end %>
            </div>
          </div>

          <h2><%= link_to condition.description, condition_path(condition), class: "condition-title-link" %></h2>
          
          <div class="symptom-tags-wrapper">
            <% if condition.symptoms.present? %>
              <% condition.symptoms.split(/[,;\n]+/).each do |symptom| %>
                <span class="symptom-tag"><%= symptom.strip %></span>
              <% end %>
            <% else %>
              <p class="text-muted small mb-0">No symptoms added yet.</p>
            <% end %>
          </div>

          <div class="condition-meta">
            <span>Diagnosed on</span>
            <strong>
              <%= condition.diagnosed_on ? condition.diagnosed_on.strftime("%b %d, %Y") : "Not added" %>
            </strong>
          </div>

          <div class="condition-card-actions">
            <%= link_to "Details →", condition_path(condition), class: "condition-card-link" %>
            
            <% if condition.archived? %>
              <%= button_to unarchive_condition_path(condition), method: :patch, class: "btn btn-outline btn-sm" do %>
                <i class="fa-solid fa-arrow-rotate-left me-1"></i> Restore
              <% end %>
            <% else %>
              <% if condition.chat.present? %>
                <%= link_to condition_chat_path(condition, condition.chat), class: "btn btn-ai-chat" do %>
                  <i class="fa-solid fa-wand-magic-sparkles"></i> Talk to AI
                <% end %>
              <% else %>
                <%= button_to condition_chats_path(condition), method: :post, class: "btn btn-ai-chat" do %>
                  <i class="fa-solid fa-wand-magic-sparkles"></i> Talk to AI
                <% end %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <% if @tab == 'archived' %>
        <h2>No archived conditions</h2>
        <p>Conditions you move to the archive will appear here for your medical records.</p>
        <%= link_to "View active conditions", conditions_path(tab: :active), class: "btn btn-outline mt-3" %>
      <% else %>
        <h2>No active conditions</h2>
        <p>Your conditions will appear here after they are created.</p>
        <%= link_to "Add your first condition", new_condition_path, class: "btn btn-primary mt-3" %>
      <% end %>
    </div>
  <% end %>
</div>

