
<div class="condition-show-page">
  <%= link_to "← Back to my conditions", conditions_path, class: "back-link" %>

  <div class="condition-show-card">
    <div class="condition-show-header">
      <div>
        <p class="eyebrow">CONDITION DETAILS</p>
        <h1><%= @condition.description %></h1>
      </div>

      <div class="d-flex gap-2 align-items-center">
        <% if @condition.archived? %>
          <span class="condition-status status-archived">Archived</span>
        <% else %>
          <span class="condition-status <%= @condition.cured? ? 'status-cured' : 'status-active' %>">
            <%= @condition.cured? ? "Cured" : "Active" %>
          </span>
        <% end %>
      </div>
    </div>

    <div class="condition-detail-grid">
      <div class="condition-detail-box">
        <span>Symptoms</span>
        <strong><%= @condition.symptoms.presence || "No symptoms added yet." %></strong>
      </div>

      <div class="condition-detail-box">
        <span>Diagnosed on</span>
        <strong>
          <%= @condition.diagnosed_on ? @condition.diagnosed_on.strftime("%B %d, %Y") : "Not added" %>
        </strong>
      </div>
    </div>
    <div class="condition-show-actions">
      <% if @condition.chat.present? %>
        <%= link_to condition_chat_path(@condition, @condition.chat), class: "btn btn-primary btn-large" do %>
          <i class="fa-solid fa-comments me-2"></i> Chat with AI Bot
        <% end %>
      <% else %>
        <%= button_to condition_chats_path(@condition), method: :post, class: "btn btn-primary btn-large" do %>
          <i class="fa-solid fa-comments me-2"></i> Chat with AI Bot
        <% end %>
      <% end %>
      <%= button_to toggle_cured_condition_path(@condition), method: :patch, class: "btn #{@condition.cured? ? 'btn-outline' : 'btn-cured-toggle'}" do %>
        <% if @condition.cured? %>
          <i class="fa-solid fa-arrow-rotate-left me-1"></i> Mark as Active
        <% else %>
          <i class="fa-solid fa-circle-check me-1"></i> Mark as Cured
        <% end %>
      <% end %>

      <%= link_to edit_condition_path(@condition), class: "btn btn-outline" do %>
        <i class="fa-solid fa-pen-to-square me-1"></i> Edit condition
      <% end %>
    </div>
  </div>
</div>
