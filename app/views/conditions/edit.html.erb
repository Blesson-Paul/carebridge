<div class="condition-form-page">
  <%= link_to "← Back to condition", condition_path(@condition), class: "back-link" %>

  <div class="condition-form-card">
    <div class="d-flex justify-content-between align-items-start">
      <div>
        <h1>Edit condition</h1>
        <p class="condition-form-subtitle">
          Update condition name, symptoms, or diagnosis date.
        </p>
      </div>
      <% if @condition.archived? %>
        <%= button_to unarchive_condition_path(@condition),
                      method: :patch,
                      class: "btn btn-outline" do %>
          <i class="fa-solid fa-arrow-rotate-left me-1"></i> Restore to Active
        <% end %>
      <% else %>
        <%= button_to archive_condition_path(@condition),
                      method: :patch,
                      data: { turbo_confirm: "Move this condition to your archive history?" },
                      class: "btn btn-outline btn-logout" do %>
          <i class="fa-solid fa-box-archive me-1"></i> Move to Archive
        <% end %>
      <% end %>
    </div>

    <%= simple_form_for @condition do |f| %>
      <div class="form-inputs">
        <%= f.input :description,
                    label: "Condition name",
                    required: true,
                    placeholder: "Example: Migraine" %>

        <%= f.input :symptoms,
                    as: :text,
                    required: true,
                    placeholder: "Example: Headache, nausea, light sensitivity" %>

        <%= f.input :diagnosed_on,
                    as: :date,
                    html5: true,
                    required: true,
                    label: "Diagnosed on" %>
      </div>

      <div class="form-actions d-flex gap-3">
        <%= f.button :submit, "Save changes", class: "btn btn-primary" %>
        <%= link_to "Cancel", condition_path(@condition), class: "btn btn-outline" %>
      </div>
    <% end %>
  </div>
</div>
