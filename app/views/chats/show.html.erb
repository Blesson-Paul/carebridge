<div class="chat-page">
  <%= link_to "← Back to #{@chat.condition.description}", condition_path(@chat.condition), class: "back-link" %>
  <%= turbo_stream_from @chat %>
  <div class="chat-card">
    <div class="chat-header">
      <div class="chat-avatar">
        <i class="fa-solid fa-wand-magic-sparkles"></i>
      </div>
      <div>
        <h1><%= @chat.condition.description || "CareBrigde Assisant" %></h1>
        <p class="chat-subtitle">Symptoms: <strong><%= @chat.condition.symptoms%></strong></p>
      </div>
    </div>
      <!-- 🛡️ Medical Disclaimer Banner -->
      <div class="chat-disclaimer-banner">
      <i class="fa-solid fa-shield-heart"></i>
      <span><strong>Medical Disclaimer:</strong> CareBridge is an AI health assistant, not a doctor. This advice is for informational purposes only and not a substitute for professional medical diagnosis or emergency care.</span>
      </div>
    <div class="messages-container" id="messages">
      <% if @chat.messages.any? %>
        <% @chat.messages.each do |message| %>
          <%= render "chats/message", message: message %>
        <% end %>
      <% else %>
        <div class="chat-empty-state">
          <div class="empty-icon">
            <i class="fa-regular fa-comments"></i>
          </div>
          <h3>Start your conversation</h3>
          <p>Ask any questions about symptoms, self-care routines, or management options for <strong><%= @chat.condition.description %></strong>.</p>
        </div>
      <% end %>
    </div>

    <div id="new_message_container" class="chat-input-section">
      <%= render "messages/form", chat: @chat, message: @message %>
    </div>
  </div>
</div>
