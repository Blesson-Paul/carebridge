<% if message.role == "user" %>
  <div class="message-wrapper message-user">
    <div class="message-bubble">
      <div class="message-header">
        <strong>You</strong>
        <span class="message-time"><%= message.created_at.strftime("%I:%M %p") %></span>
      </div>

      <div class="message-content">
        <%= simple_format(message.content) %>
      </div>
    </div>
  </div>
<% elsif message.role == "assistant" %>
  <div class="message-wrapper message-assistant" id="<%= dom_id(message) %>">
    <div class="message-bubble">
      <div class="message-header">
        <strong>Your CareBridge Assistant</strong>
        <span class="message-time"><%= message.created_at.strftime("%I:%M %p") %></span>
      </div>

      <div class="message-content">
        <%= simple_format(message.content) %>
      </div>
    </div>
  </div>
<% end %>
